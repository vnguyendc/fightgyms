# copy to web/.env.local (gitignored). every value here is optional for a local demo build.
NEXT_PUBLIC_SITE_URL=https://www.findfightgyms.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SHOW_SAMPLE=1  # fictional demo, non-production only

# /for-gyms contact (build-time, public)
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# featured listings via stripe checkout. server-only; leave unset to keep the email fallback.
STRIPE_SECRET_KEY=
STRIPE_FEATURED_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# used only by /api/stripe/webhook to call sync_featured_subscription. never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
